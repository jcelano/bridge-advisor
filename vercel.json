{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "react-app/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "react-app/dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/(.*)", "dest": "react-app/$1" }
  ]
}
