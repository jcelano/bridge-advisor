# ── Required ──────────────────────────────────────────────
# Get your API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Postgres connection string (Supabase, Render Postgres, or any Postgres)
# Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ── Authentication ────────────────────────────────────────
# IMPORTANT: Set a strong random secret for production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# Token expiry (default: 7 days). Examples: "1d", "12h", "30d"
# JWT_EXPIRY=7d

# Set to "false" to disable auth entirely (useful for local dev)
# AUTH_ENABLED=false

# ── Bot Protection (Cloudflare Turnstile) ────────────────
# Free CAPTCHA alternative. Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# If not set, Turnstile is disabled (forms work without bot check)
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Email (Resend) ───────────────────────────────────────
# Free tier: 100 emails/day. Get key at https://resend.com/api-keys
# If not set, emails are logged to console instead of sent
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=The Stayman Whisperer <onboarding@resend.dev>

# Admin email for access request notifications
# ADMIN_EMAIL=you@example.com

# App URL for links in emails (password reset, admin dashboard)
# APP_URL=https://your-app.onrender.com

# ── Stripe (Pro Tier Payments) ────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_PRICE_ID=price_xxxxx           # Price ID for the $3/month pro plan
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx     # From Stripe webhook endpoint config

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: localhost only)
# ALLOWED_ORIGINS=https://your-app.onrender.com,http://localhost:5174

# ── Optional ──────────────────────────────────────────────
# Free tier daily analysis limit (default: 5). Change via env var or per-user in DB.
# FREE_DAILY_LIMIT=5

# Claude model (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Server port (default: 3001)
# PORT=3001

# Which frontend build to serve in production (default: dist-react)
# SERVE_DIR=dist-react

# Force SSL for database connection (auto-detected for Supabase URLs)
# DB_SSL=true
